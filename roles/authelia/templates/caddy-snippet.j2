# This file is managed by the osahris.cute_devops.authelia Ansible role!
# MANUAL CHANGES WILL BE OVERWRITTEN WITHOUT WARNING!
#
# Gate a vhost with `import authelia` at the top of its block. On allow the
# request carries X-Auth-Request-User / -Email / -Preferred-Username; on
# deny the browser is redirected to the portal.

(authelia) {
	forward_auth {{ authelia_caddy_upstream }} {
		uri /api/authz/forward-auth
		copy_headers Remote-User>X-Auth-Request-User Remote-User>X-Auth-Request-Preferred-Username Remote-Email>X-Auth-Request-Email
	}
}
