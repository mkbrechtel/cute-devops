#
# Claude Code SessionStart hook — one system-wide copy, deployed to
# /etc/claude/hooks by the osahris.cute_devops.claude_code role.
#
# Marks the work base directories (default: /work) as trusted in the calling
# user's ~/.claude.json. Trust is inherited from ancestors, so one trusted
# base covers every pad and worktree below it — the fleet view
# (`claude agents`) then runs the worktree hooks no matter which work
# directory it was launched from. Claude Code has no supported way to
# pre-trust directories centrally (upstream anthropics/claude-code#23109);
# until it does, this re-seeds the per-project trust flag on every session
# start. Headless and background sessions run their hooks regardless of
# trust, so seeding works before any directory has been trusted
# interactively, and re-seeding heals the flag if an exiting Claude Code
# process rewrites ~/.claude.json from a stale snapshot (upstream
# anthropics/claude-code#36403).
#
# SessionStart stdout is injected into the session's context — stay silent.
set -u
cat >/dev/null || true

exec python3 - "${@:-/work}" <<'EOF' >/dev/null 2>&1
import json, os, sys

path = os.path.expanduser("~/.claude.json")
try:
    with open(path) as f:
        data = json.load(f)
except (OSError, ValueError):
    sys.exit(0)  # no config yet, or unreadable — never break session start

# Obsolete state from an earlier per-directory design.
try:
    os.remove(os.path.expanduser("~/.claude/trust-work-dirs.seeded"))
except OSError:
    pass

projects = data.setdefault("projects", {})
changed = False
for base in sys.argv[1:]:
    if not os.path.isdir(base):
        continue
    entry = projects.setdefault(os.path.realpath(base), {})
    if not entry.get("hasTrustDialogAccepted"):
        entry["hasTrustDialogAccepted"] = True
        changed = True

if changed:
    tmp = path + ".trust-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)
EOF
