#
# Claude Code SessionStart hook — one system-wide copy, deployed to
# /etc/claude/hooks by the osahris.cute_devops.claude_code role.
#
# Marks the work directory the session runs in as trusted in the calling
# user's ~/.claude.json, so the interactive fleet view (`claude agents`) is
# willing to run the worktree hooks there. Claude Code has no supported way
# to pre-trust directories centrally (see upstream anthropics/claude-code
# #23109); until it does, this hook re-seeds the undocumented per-project
# trust flag whenever a session starts in a work directory. Headless and
# background sessions run their hooks regardless of trust, so seeding works
# even before any directory has been trusted interactively.
#
# Trusts only what the session touches: the pad (<base>/<project>) the
# session's cwd falls under, plus the cwd itself when it is a worktree below
# that pad. Arguments: work base directories (default: /work).
#
# Claude Code processes rewrite ~/.claude.json from an in-memory snapshot on
# exit, so a freshly seeded flag can be wiped by any session that started
# before the seed (upstream anthropics/claude-code#36403). To self-heal, every
# directory ever seeded is recorded in ~/.claude/trust-work-dirs.seeded and
# the whole record is re-asserted on every invocation — a clobbered flag comes
# back on the next session start anywhere.
#
# SessionStart stdout is injected into the session's context — stay silent.
set -u

payload="$(cat || true)"
cwd="$(printf '%s' "$payload" \
  | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  | head -n1)"
[ -z "$cwd" ] && cwd="$PWD"

exec python3 - "$cwd" "${@:-/work}" <<'EOF' >/dev/null 2>&1
import json, os, sys

cwd = os.path.realpath(sys.argv[1])
pad = None
for base in sys.argv[2:]:
    base = os.path.realpath(base)
    if os.path.commonpath([cwd, base]) == base and cwd != base:
        rel = os.path.relpath(cwd, base)
        pad = os.path.join(base, rel.split(os.sep)[0])
        break

dirs = []
if pad is not None:
    dirs.append(pad)
    if cwd != pad:
        dirs.append(cwd)

record = os.path.expanduser("~/.claude/trust-work-dirs.seeded")
try:
    with open(record) as f:
        recorded = [l.strip() for l in f if l.strip()]
except OSError:
    recorded = []
dirs = list(dict.fromkeys(recorded + dirs))  # keep order, dedupe
if not dirs:
    sys.exit(0)  # session outside any work dir and nothing recorded yet

if dirs != recorded:
    os.makedirs(os.path.dirname(record), exist_ok=True)
    tmp = record + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(dirs) + "\n")
    os.replace(tmp, record)

path = os.path.expanduser("~/.claude.json")
try:
    with open(path) as f:
        data = json.load(f)
except (OSError, ValueError):
    sys.exit(0)  # no config yet, or unreadable — never break session start

projects = data.setdefault("projects", {})
changed = False
for d in dirs:
    entry = projects.setdefault(d, {})
    if not entry.get("hasTrustDialogAccepted"):
        entry["hasTrustDialogAccepted"] = True
        changed = True

if changed:
    tmp = path + ".trust-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)
EOF
