#
# Claude Code WorktreeRemove hook — one system-wide copy, deployed to
# /etc/claude/hooks by the osahris.cute_devops.claude_code role. Counterpart of
# worktree-create: removes a worktree it could have created, and nothing else.
set -euo pipefail

payload="$(cat || true)"

extract() {
  printf '%s' "$payload" \
    | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
    | head -n1
}
path="$(extract worktree_path)"
[ -z "$path" ] && path="$(extract path)"

if [ -z "$path" ]; then
  echo "worktree-remove: no path in payload" >&2
  exit 0
fi

# Resolve the repo from the worktree being removed, not from the process CWD:
# the hook may be invoked from anywhere (deleting a background session runs it
# from wherever `claude` happened to be started), and the payload path is what
# identifies the repository. Fall back to the CWD only for a worktree that has
# already vanished from disk, so its admin entry can still be pruned.
common=""
if [ -d "$path" ]; then
  gitdir="$(cd "$path" && git rev-parse --git-common-dir 2>/dev/null)" || gitdir=""
  if [ -n "$gitdir" ]; then
    common="$(cd "$path" && cd "$gitdir" && pwd)"
  fi
fi
if [ -z "$common" ]; then
  gitdir="$(git rev-parse --git-common-dir 2>/dev/null)" || gitdir=""
  if [ -n "$gitdir" ]; then
    common="$(cd "$gitdir" && pwd)"
  fi
fi
if [ -z "$common" ]; then
  if [ ! -e "$path" ]; then
    # Nothing on disk and no repository in reach — nothing left to do.
    exit 0
  fi
  echo "worktree-remove: cannot locate the repository for $path" >&2
  exit 1
fi
cd /

# Where may this hook delete? Only where worktree-create creates: under the
# shared work directory (`cute.workdir` layout), or under <clone>/work/ of a
# personal checkout — and never the base directory itself. A typo (or a
# prompt-injected agent) must not be able to delete arbitrary paths.
workdir="$(git --git-dir="$common" config --default '' cute.workdir)"
if [ -n "$workdir" ]; then
  fence="$workdir"
else
  root="$(git --git-dir="$common" worktree list --porcelain | sed -n 's/^worktree //p' | head -n1)"
  fence="$root/work"
fi
case "$path" in
  "$fence"/*/) ;;
  "$fence"/*) ;;
  *)
    echo "worktree-remove: refusing to remove $path (outside $fence/)" >&2
    exit 1
    ;;
esac

git --git-dir="$common" worktree remove "$path" 2>/dev/null \
  || git --git-dir="$common" worktree remove --force "$path" 2>/dev/null \
  || rm -rf "$path"

git --git-dir="$common" worktree prune >/dev/null 2>&1 || true
