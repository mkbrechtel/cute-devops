#
# Claude Code WorktreeRemove hook — one system-wide copy, deployed to
# /etc/claude/hooks by the osahris.cute_devops.claude_code role. Counterpart of
# worktree-create: removes a worktree it could have created, and nothing else.
set -euo pipefail

payload="$(cat || true)"

# The payload carries the worktree under `worktree_path` — the only
# event-specific field Claude Code sends for this event.
extract() {
  printf '%s' "$payload" \
    | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
    | head -n1
}
path="$(extract worktree_path)"

if [ -z "$path" ]; then
  echo "worktree-remove: no path in payload" >&2
  exit 0
fi

# Claude Code always sends an absolute path, but a relative name (the same
# `<category>/<branch>` worktree-create accepts) is resolved against the base
# directory of the repository around the CWD, so both spellings work by hand.
case "$path" in
  /*) ;;
  *)
    cwd_common="$(git rev-parse --git-common-dir 2>/dev/null)" || cwd_common=""
    if [ -z "$cwd_common" ]; then
      echo "worktree-remove: '$path' is relative and the CWD is not in a git repository" >&2
      exit 1
    fi
    cwd_common="$(cd "$cwd_common" && pwd)"
    cwd_workdir="$(git --git-dir="$cwd_common" config --default '' cute.workdir)"
    if [ -n "$cwd_workdir" ]; then
      path="$cwd_workdir/$path"
    else
      cwd_root="$(git --git-dir="$cwd_common" worktree list --porcelain | sed -n 's/^worktree //p' | head -n1)"
      path="$cwd_root/work/$path"
    fi
    ;;
esac

# A worktree that is already gone from disk is a success, not an error: the
# point of the hook is that the path no longer exists afterwards. Prune its
# stale admin entry if a repository is in reach (the CWD may or may not be in
# one), then report success either way.
if [ ! -e "$path" ]; then
  gitdir="$(git rev-parse --git-common-dir 2>/dev/null)" || gitdir=""
  if [ -n "$gitdir" ]; then
    git --git-dir="$gitdir" worktree prune >/dev/null 2>&1 || true
  fi
  exit 0
fi

# Resolve the repo from the worktree being removed, not from the process CWD:
# the hook may be invoked from anywhere (deleting a background session runs it
# from wherever `claude` happened to be started), and the payload path is what
# identifies the repository.
gitdir="$(cd "$path" && git rev-parse --git-common-dir 2>/dev/null)" || gitdir=""
if [ -z "$gitdir" ]; then
  echo "worktree-remove: cannot locate the repository for $path" >&2
  exit 1
fi
common="$(cd "$path" && cd "$gitdir" && pwd)"
cd /

# Where may this hook delete? Only where worktree-create creates: under the
# shared work directory (`cute.workdir` layout), or under <clone>/work/ of a
# personal checkout — and never the base directory itself. A typo (or a
# prompt-injected agent) must not be able to delete arbitrary paths.
workdir="$(git --git-dir="$common" config --default '' cute.workdir)"
if [ -n "$workdir" ]; then
  fence="$workdir"
else
  root="$(git --git-dir="$common" worktree list --porcelain | sed -n 's/^worktree //p' | head -n1)"
  fence="$root/work"
fi
case "$path" in
  "$fence"/*/) ;;
  "$fence"/*) ;;
  *)
    echo "worktree-remove: refusing to remove $path (outside $fence/)" >&2
    exit 1
    ;;
esac

# Never destroy uncommitted work: fail (keeping the worktree) if anything is
# modified, staged, or untracked. Unpushed commits are fine — they live on the
# branch, which removal leaves untouched.
if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
  echo "worktree-remove: $path has uncommitted changes — commit or discard them first" >&2
  exit 1
fi

# The worktree is clean; --force only papers over non-content refusals that
# remain after the cleanliness check (e.g. submodules), and rm -rf catches a
# worktree git considers broken.
git --git-dir="$common" worktree remove "$path" 2>/dev/null \
  || git --git-dir="$common" worktree remove --force "$path" 2>/dev/null \
  || rm -rf "$path"

git --git-dir="$common" worktree prune >/dev/null 2>&1 || true
