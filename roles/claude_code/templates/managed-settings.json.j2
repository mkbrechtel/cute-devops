{% set settings = {
  "worktree": {"bgIsolation": "worktree"},
  "hooks": {
    "WorktreeCreate": [
      {"hooks": [{"type": "command", "command": claude_code_hooks_dir ~ "/worktree-create"}]}
    ],
    "WorktreeRemove": [
      {"hooks": [{"type": "command", "command": claude_code_hooks_dir ~ "/worktree-remove"}]}
    ]
  }
} %}
{% if claude_code_with_require_clean %}
{% set _ = settings.hooks.update({
  "Stop": [
    {"hooks": [{"type": "command", "command": claude_code_hooks_dir ~ "/require-clean"}]}
  ]
}) %}
{% endif %}
{% if claude_code_with_trust_work_dirs %}
{% set _ = settings.hooks.update({
  "SessionStart": [
    {"hooks": [{"type": "command", "command": claude_code_hooks_dir ~ "/trust-work-dirs " ~ (claude_code_trust_work_bases | join(" "))}]}
  ],
  "SessionEnd": [
    {"hooks": [{"type": "command", "command": claude_code_hooks_dir ~ "/trust-work-dirs " ~ (claude_code_trust_work_bases | join(" "))}]}
  ]
}) %}
{% endif %}
{{ settings | to_nice_json }}
